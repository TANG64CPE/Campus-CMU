PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusmart?schema=public
JWT_SECRET=supersecret_cmu_campusmart_jwt_key_2026_dev
FRONTEND_URL=http://localhost:5173

# CMU OAuth 2.0 Credentials
CMU_OAUTH_CLIENT_ID=your_cmu_client_id_here
CMU_OAUTH_CLIENT_SECRET=your_cmu_client_secret_here
CMU_OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Local Dev Mock Auth Toggle (true allows mock CMU student accounts for local testing)
ENABLE_MOCK_AUTH=true
